rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAnalyticsOwner() {
      return isSignedIn()
        && request.auth.token.pdfenrichAdmin == true;
    }

    function accountAcceptsContentWrites(userId) {
      return !exists(/databases/$(database)/documents/_privateCloudAccountState/$(userId))
        || get(/databases/$(database)/documents/_privateCloudAccountState/$(userId)).data.state == "active";
    }

    function hasValidAnalyticsActor() {
      return (request.auth == null && request.resource.data.actorId == null)
        || (isSignedIn()
          && request.resource.data.actorId == request.auth.uid
          && accountAcceptsContentWrites(request.auth.uid));
    }

    function hasValidAnalyticsProperties() {
      let properties = request.resource.data.properties;
      return properties.keys().hasOnly([
          "toolId",
          "fileSizeBucket",
          "pageCountBucket",
          "errorCategory",
          "result",
          "authMethod",
          "route",
          "operation",
          "durationBucket",
          "durationMs",
          "deviceClass",
          "browserFamily",
          "trafficSource",
          "referrerDomain",
          "landingPath"
        ])
        && (!("toolId" in properties) || (properties.toolId is string && properties.toolId.size() <= 80))
        && (!("fileSizeBucket" in properties) || (properties.fileSizeBucket is string && properties.fileSizeBucket.size() <= 40))
        && (!("pageCountBucket" in properties) || (properties.pageCountBucket is string && properties.pageCountBucket.size() <= 40))
        && (!("errorCategory" in properties) || (properties.errorCategory is string && properties.errorCategory.size() <= 80))
        && (!("result" in properties) || (properties.result is string && properties.result.size() <= 80))
        && (!("authMethod" in properties) || properties.authMethod in ["email", "google"])
        && (!("route" in properties) || (properties.route is string && properties.route.size() <= 160))
        && (!("operation" in properties) || (properties.operation is string && properties.operation.size() <= 80))
        && (!("durationBucket" in properties) || (properties.durationBucket is string && properties.durationBucket.size() <= 40))
        && (!("durationMs" in properties) || (properties.durationMs is number && properties.durationMs >= 0 && properties.durationMs <= 1800000))
        && (!("deviceClass" in properties) || properties.deviceClass in ["desktop", "mobile", "unknown"])
        && (!("browserFamily" in properties) || properties.browserFamily in ["chrome", "edge", "firefox", "safari", "other", "unknown"])
        && (!("trafficSource" in properties) || properties.trafficSource in ["organic", "referral", "social", "email", "paid", "campaign", "direct"])
        && (!("referrerDomain" in properties) || (properties.referrerDomain is string && properties.referrerDomain.size() <= 120))
        && (!("landingPath" in properties) || (properties.landingPath is string && properties.landingPath.size() <= 160));
    }

    match /users/{userId}/documents/{documentId} {
      // Temporary read/delete-only bridge for the prior JSON workspace format.
      // New records and all v2 private metadata are server-authoritative.
      allow get, list, delete: if isSignedIn()
        && request.auth.uid == userId
        && resource.data.ownerId == request.auth.uid
        && resource.data.payloadPath == "users/" + userId + "/documents/" + documentId + "/document.json";
      allow create, update: if false;
    }

    match /users/{userId}/privateDocuments/{documentId} {
      allow read, write: if false;

      match /versions/{versionId} {
        allow read, write: if false;
      }
    }

    match /users/{userId}/privateCloudSettings/{settingId} {
      allow read, write: if false;
    }

    match /users/{userId}/privateCloudUploads/{uploadId} {
      allow read, write: if false;
    }

    match /users/{userId}/privateCloudShares/{shareId} {
      allow read, write: if false;
    }

    match /authUserProfiles/{userId} {
      allow create, update: if isSignedIn()
        && request.auth.uid == userId
        && accountAcceptsContentWrites(userId)
        && request.resource.data.keys().hasAll([
          "uid",
          "email",
          "displayName",
          "provider",
          "lastSignInAt",
          "updatedAt"
        ])
        && request.resource.data.keys().hasOnly([
          "uid",
          "email",
          "displayName",
          "provider",
          "lastSignInAt",
          "updatedAt"
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 160
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.provider in ["google", "email"]
        && request.resource.data.lastSignInAt is string
        && request.resource.data.lastSignInAt.size() <= 40
        && request.resource.data.updatedAt == request.time;
      allow read: if isAnalyticsOwner()
        || (isSignedIn() && request.auth.uid == userId);
      allow delete: if isAnalyticsOwner()
        || (isSignedIn() && request.auth.uid == userId);
    }

    match /shareLinks/{shareId} {
      function isCurrentShareId() {
        return shareId.matches("^[a-f0-9]{64}$");
      }

      function isLegacyShareId() {
        return shareId.matches("^[A-Za-z0-9_-]{32}$");
      }

      function sourceDocumentIsActive() {
        return !("sourceDocumentId" in resource.data)
          || (exists(/databases/$(database)/documents/users/$(resource.data.ownerId)/privateDocuments/$(resource.data.sourceDocumentId))
            && get(/databases/$(database)/documents/users/$(resource.data.ownerId)/privateDocuments/$(resource.data.sourceDocumentId)).data.ownerId == resource.data.ownerId
            && get(/databases/$(database)/documents/users/$(resource.data.ownerId)/privateDocuments/$(resource.data.sourceDocumentId)).data.state == "active");
      }

      allow get: if (isCurrentShareId() || isLegacyShareId())
        && ((resource.data.status == "active"
            && resource.data.expiresAt > request.time
            && accountAcceptsContentWrites(resource.data.ownerId)
            && sourceDocumentIsActive())
          || (isSignedIn() && resource.data.ownerId == request.auth.uid));
      allow list: if false;
      allow create: if isSignedIn()
        && isCurrentShareId()
        && accountAcceptsContentWrites(request.auth.uid)
        && request.resource.data.keys().hasAll([
          "ownerId",
          "fileName",
          "size",
          "contentType",
          "status",
          "allowDownload",
          "createdAt",
          "expiresAt"
        ])
        && request.resource.data.keys().hasOnly([
          "ownerId",
          "sourceDocumentId",
          "fileName",
          "size",
          "contentType",
          "storagePath",
          "chunkCount",
          "status",
          "allowDownload",
          "createdAt",
          "expiresAt"
        ])
        && request.resource.data.ownerId == request.auth.uid
        && (!("sourceDocumentId" in request.resource.data)
          || (request.resource.data.sourceDocumentId is string
            && request.resource.data.sourceDocumentId.matches("^doc_[A-Za-z0-9_-]{24}$")
            && exists(/databases/$(database)/documents/users/$(request.auth.uid)/privateDocuments/$(request.resource.data.sourceDocumentId))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)/privateDocuments/$(request.resource.data.sourceDocumentId)).data.ownerId == request.auth.uid
            && get(/databases/$(database)/documents/users/$(request.auth.uid)/privateDocuments/$(request.resource.data.sourceDocumentId)).data.state == "active"))
        && request.resource.data.fileName is string
        && request.resource.data.fileName.size() > 0
        && request.resource.data.fileName.size() <= 124
        && request.resource.data.size is int
        && request.resource.data.size > 0
        && request.resource.data.size <= 26214400
        && request.resource.data.contentType == "application/pdf"
        && "storagePath" in request.resource.data
        && request.resource.data.storagePath == "shares/" + shareId + "/document.pdf"
        && !("chunkCount" in request.resource.data)
        && request.resource.data.status == "uploading"
        && request.resource.data.allowDownload is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt <= request.time + duration.value(5, "m")
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(30, "d");
      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && (
          (isCurrentShareId()
            && accountAcceptsContentWrites(request.auth.uid)
            && resource.data.status == "uploading"
            && sourceDocumentIsActive()
            && request.resource.data.status == "active"
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"]))
          || ((isCurrentShareId() || isLegacyShareId())
            && resource.data.status in ["uploading", "active", "revoked"]
            && request.resource.data.status == "revoked"
            && request.resource.data.revokedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "status",
              "revokedAt"
            ]))
        );
      // Keep the owner/object association until trusted backend cleanup.
      // Direct deletion can orphan shares/{shareId}/document.pdf.
      allow delete: if false;

      match /chunks/{chunkId} {
        function shareRecord() {
          return get(/databases/$(database)/documents/shareLinks/$(shareId));
        }

        function isShareOwner() {
          return isSignedIn() && shareRecord().data.ownerId == request.auth.uid;
        }

        function linkedSourceDocumentIsActive() {
          let share = shareRecord();
          return !("sourceDocumentId" in share.data)
            || (share.data.sourceDocumentId is string
              && share.data.sourceDocumentId.matches("^doc_[A-Za-z0-9_-]{24}$")
              && exists(/databases/$(database)/documents/users/$(share.data.ownerId)/privateDocuments/$(share.data.sourceDocumentId))
              && get(/databases/$(database)/documents/users/$(share.data.ownerId)/privateDocuments/$(share.data.sourceDocumentId)).data.ownerId == share.data.ownerId
              && get(/databases/$(database)/documents/users/$(share.data.ownerId)/privateDocuments/$(share.data.sourceDocumentId)).data.state == "active");
        }

        allow get, list: if isLegacyShareId()
          && ((shareRecord().data.status == "active"
              && shareRecord().data.expiresAt > request.time
              && accountAcceptsContentWrites(shareRecord().data.ownerId)
              && linkedSourceDocumentIsActive())
            || isShareOwner());
        // Existing legacy chunks remain readable/revocable during migration,
        // but new PDF bytes may never be stored as Firestore blobs.
        allow create: if false;
        allow update: if false;
        allow delete: if isShareOwner();
      }
    }

    match /signingRequests/{tokenHash} {
      function validTokenHash() {
        return tokenHash.matches("^[a-f0-9]{64}$");
      }

      function linkedShare() {
        return get(/databases/$(database)/documents/shareLinks/$(tokenHash));
      }

      function validParty(party) {
        return party is map
          && party.keys().hasOnly(["name", "email"])
          && party.name is string
          && party.name.size() <= 100
          && party.email is string
          && party.email.size() > 3
          && party.email.size() <= 160;
      }

      function linkedSourceDocumentIsActive() {
        let share = linkedShare();
        return !("sourceDocumentId" in share.data)
          || (exists(/databases/$(database)/documents/users/$(share.data.ownerId)/privateDocuments/$(share.data.sourceDocumentId))
            && get(/databases/$(database)/documents/users/$(share.data.ownerId)/privateDocuments/$(share.data.sourceDocumentId)).data.ownerId == share.data.ownerId
            && get(/databases/$(database)/documents/users/$(share.data.ownerId)/privateDocuments/$(share.data.sourceDocumentId)).data.state == "active");
      }

      allow get: if validTokenHash()
        && ((resource.data.status == "active"
            && resource.data.expiresAt > request.time
            && linkedShare().data.status == "active"
            && linkedShare().data.expiresAt > request.time
            && accountAcceptsContentWrites(resource.data.ownerId)
            && linkedSourceDocumentIsActive()
            && resource.data.expiresAt == linkedShare().data.expiresAt)
          || (isSignedIn() && resource.data.ownerId == request.auth.uid));
      allow list: if false;
      allow create: if validTokenHash()
        && isSignedIn()
        && accountAcceptsContentWrites(request.auth.uid)
        && linkedShare().data.ownerId == request.auth.uid
        && linkedShare().data.status == "active"
        && linkedShare().data.expiresAt > request.time
        && linkedSourceDocumentIsActive()
        && request.resource.data.keys().hasAll([
          "ownerId",
          "version",
          "requestId",
          "recipient",
          "requester",
          "message",
          "fields",
          "status",
          "createdAt",
          "expiresAt"
        ])
        && request.resource.data.keys().hasOnly([
          "ownerId",
          "version",
          "requestId",
          "recipient",
          "requester",
          "message",
          "fields",
          "status",
          "createdAt",
          "expiresAt"
        ])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.version == 1
        && request.resource.data.requestId is string
        && request.resource.data.requestId.size() >= 16
        && request.resource.data.requestId.size() <= 80
        && validParty(request.resource.data.recipient)
        && validParty(request.resource.data.requester)
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 500
        && request.resource.data.fields is list
        && request.resource.data.fields.size() > 0
        && request.resource.data.fields.size() <= 100
        && request.resource.data.status == "active"
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt <= request.time + duration.value(5, "m")
        && request.resource.data.expiresAt == linkedShare().data.expiresAt;
      allow update: if validTokenHash()
        && accountAcceptsContentWrites(resource.data.ownerId)
        && resource.data.status == "active"
        && resource.data.expiresAt > request.time
        && linkedShare().data.status == "active"
        && linkedShare().data.expiresAt > request.time
        && linkedSourceDocumentIsActive()
        && resource.data.expiresAt == linkedShare().data.expiresAt
        && request.resource.data.status == "completed"
        && request.resource.data.completedAt == request.time
        && request.resource.data.completionChecksum is string
        && request.resource.data.completionChecksum.matches("^[a-f0-9]{64}$")
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "completedAt",
          "completionChecksum"
        ]);
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /_privateCloudAccountState/{userId} {
      allow read, write: if false;
    }

    match /productAnalyticsEvents/{eventId} {
      allow create: if request.resource.data.keys().hasAll([
          "name",
          "properties",
          "actorId",
          "visitorId",
          "occurredAt",
          "clientOccurredAt"
        ])
        && request.resource.data.keys().hasOnly([
          "name",
          "properties",
          "actorId",
          "visitorId",
          "occurredAt",
          "clientOccurredAt",
          "expiresAt"
        ])
        && request.resource.data.name in [
          "homepage_viewed",
          "page_viewed",
          "tool_opened",
          "upload_started",
          "upload_validation_failed",
          "document_opened",
          "edit_made",
          "export_started",
          "export_succeeded",
          "export_failed",
          "related_tool_clicked",
          "optional_account_created",
          "account_signed_up",
          "account_logged_in",
          "pdf_downloaded",
          "result_downloaded",
          "task_feedback_submitted",
          "client_error",
          "unhandled_rejection",
          "slow_operation"
        ]
        && request.resource.data.visitorId is string
        && request.resource.data.visitorId.size() >= 10
        && request.resource.data.visitorId.size() <= 80
        && request.resource.data.occurredAt == request.time
        && request.resource.data.clientOccurredAt is string
        && request.resource.data.clientOccurredAt.size() <= 40
        && request.resource.data.properties is map
        && hasValidAnalyticsActor()
        && hasValidAnalyticsProperties()
        && (!("expiresAt" in request.resource.data)
          || (request.resource.data.expiresAt is timestamp
            && request.resource.data.expiresAt > request.time
            && request.resource.data.expiresAt <= request.time + duration.value(401, "d")));
      allow read, delete: if isAnalyticsOwner()
        || (isSignedIn() && resource.data.actorId == request.auth.uid);
      allow update: if false;
    }

    match /supportRequests/{requestId} {
      allow create: if request.resource.data.keys().hasAll([
          "name",
          "email",
          "category",
          "message",
          "status",
          "actorId",
          "createdAt",
          "clientCreatedAt"
        ])
        && request.resource.data.keys().hasOnly([
          "name",
          "email",
          "category",
          "message",
          "status",
          "actorId",
          "createdAt",
          "clientCreatedAt",
          "expiresAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 160
        && request.resource.data.category in ["product_help", "bug", "account", "privacy", "security", "other"]
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 4000
        && request.resource.data.status == "new"
        && request.resource.data.createdAt == request.time
        && request.resource.data.clientCreatedAt is string
        && request.resource.data.clientCreatedAt.size() <= 40
        && ((request.auth == null && request.resource.data.actorId == null)
          || (isSignedIn()
            && request.resource.data.actorId == request.auth.uid
            && accountAcceptsContentWrites(request.auth.uid)))
        && (!("expiresAt" in request.resource.data)
          || (request.resource.data.expiresAt is timestamp
            && request.resource.data.expiresAt > request.time
            && request.resource.data.expiresAt <= request.time + duration.value(731, "d")));
      allow read, delete: if isAnalyticsOwner()
        || (isSignedIn() && resource.data.actorId == request.auth.uid);
      allow update: if isAnalyticsOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
