  "method": {
    "source": "Seven public PDFEnrich regression fixtures",
    "encoding": "RFC 4648 standard Base64",
    "encodedLengthFormula": "4 * ceil(sourceBytes / 3)",
    "overheadFormula": "(base64Bytes - sourceBytes) / sourceBytes * 100"
