# Template only. These controls are not active until configured in the target
# Firebase Functions environment, deployed, and verified. Do not commit real
# secrets or copy production values into development.

# Exact comma-separated HTTPS browser origins allowed to call the private API.
# Wildcards are not supported.
PRIVATE_CLOUD_ALLOWED_ORIGINS=https://pdfenrich.com

# Exact comma-separated Firebase App Check application IDs allowed to call the
# API. The backend fails closed if this allowlist is empty.
PRIVATE_CLOUD_ALLOWED_APP_IDS=

# Dedicated least-privilege runtime identity. Do not use a project
# Owner/Editor or a downloadable service-account key.
PRIVATE_CLOUD_SERVICE_ACCOUNT_EMAIL=

# Exact Firebase / Google Cloud Storage bucket name for this environment.
PRIVATE_CLOUD_STORAGE_BUCKET=

# Positive decimal byte counts. The file limit cannot exceed the code hard
# limit of 52,428,800 bytes; the account quota must be at least the file limit.
PRIVATE_CLOUD_MAX_FILE_BYTES=
PRIVATE_CLOUD_ACCOUNT_QUOTA_BYTES=

# Positive decimal days, at most 90. If omitted, code defaults to 30, but the
# operator must explicitly select and disclose the production policy.
PRIVATE_CLOUD_TRASH_RETENTION_DAYS=

# Production should fail closed unless a reviewed private scanner is configured.
# The endpoint must use HTTPS and accept the runtime identity's OIDC token. No
# scanner is considered active until its isolation, logging, update, and
# clean/reject behavior have been verified.
PRIVATE_CLOUD_REQUIRE_MALWARE_SCAN=true
PRIVATE_CLOUD_MALWARE_SCANNER_URL=

# Product analytics ingestion and owner dashboard API. These settings are
# independent of private cloud storage and must be verified after deployment.
ANALYTICS_ALLOWED_ORIGINS=https://pdfenrich.com,https://www.pdfenrich.com
ANALYTICS_RETENTION_DAYS=365
# Turn this on only after Firebase App Check is configured and verified for all
# production clients. Anonymous analytics requests still work with App Check.
ANALYTICS_REQUIRE_APP_CHECK=false
